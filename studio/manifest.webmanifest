{
  "name": "Montaggio Video — Grandangolo Studio",
  "short_name": "Montaggio Video",
  "description": "Editor video di Grandangolo: tracce, titoli, lower third, sottotitoli, transizioni ed export MP4.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0c110e",
  "theme_color": "#0c110e",
  "lang": "it",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-montaggio-video": [".mvideo"] } }
  ]
}
